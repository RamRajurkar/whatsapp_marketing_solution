# ==============================================================================
# Black Angler — Root Environment Variables Example
# Copy this file to '.env' in the same directory and fill in your values.
# ==============================================================================

# ── General Settings ──────────────────────────────────────────────────────────
# Set to 'production' or 'development'
NODE_ENV=production
# Timezone configuration for containers
TZ=Asia/Kolkata

# ── FastAPI Backend Authentication ────────────────────────────────────────────
# Generate a strong random hex key with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your_jwt_signing_secret_here

# Initial Admin Credentials (created on first run if database is empty)
ADMIN_EMAIL=admin@restaurant.com
ADMIN_PASSWORD=Admin@123

# ── Database Config (Internal container URLs) ─────────────────────────────────
MONGODB_URI=mongodb://mongodb:27017
DB_NAME=resto_chat
REDIS_URL=redis://redis:6379/0

# ── WhatsApp Meta Cloud API ───────────────────────────────────────────────────
# Obtain these from the Meta Developer Dashboard: https://developers.facebook.com
# Under: Your App -> WhatsApp -> API Setup
WA_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WA_BUSINESS_ACCOUNT_ID=your_whatsapp_business_account_id
WA_ACCESS_TOKEN=your_permanent_system_user_access_token

# Verify Token: Pick a custom string/password to verify webhook endpoint ownership
WA_VERIFY_TOKEN=your_custom_verify_token

# App Secret: Copy from App Dashboard -> App Settings -> Basic -> App Secret
# Used to verify incoming webhook signatures for security (strongly recommended)
WA_APP_SECRET=your_meta_app_secret
WA_APP_ID=your_meta_app_id

# ── Supabase (Missed Message Offline Queue) ───────────────────────────────────
# Get these after creating your Supabase project in Step 2 of the guide
SUPABASE_URL=https://yourprojectid.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key

# ── Cloudflare Tunnel ─────────────────────────────────────────────────────────
# Get this from Cloudflare Zero Trust dashboard when creating your Docker-based tunnel
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token
