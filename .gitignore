*.pyc

# Frontend (Next.js)
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/.env*
frontend/*.tsbuildinfo
frontend/next-env.d.ts

# MongoDB Local (if any leftover or custom)
mongodb_local/

# General
.DS_Store
*.pem
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.env
